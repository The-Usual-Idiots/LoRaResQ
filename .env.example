# LoRaResQ Environment Configuration Template
# Copy to .env.local for local Next.js client development

# Node WebSocket target URL (defaults to ESP32 SoftAP at ws://192.168.4.1:81/ws)
# For local multi-node simulator testing, use ws://localhost:8081/ws
NEXT_PUBLIC_NODE_WS_URL=ws://192.168.4.1:81/ws

# Default simulation mode (true in local dev, false on production hardware)
NEXT_PUBLIC_DEFAULT_SIMULATED=false

# Default radio operating frequency (India SRD band Channel 15)
NEXT_PUBLIC_DEFAULT_FREQ_MHZ=865.125
NEXT_PUBLIC_DEFAULT_CHANNEL=15
NEXT_PUBLIC_DEFAULT_TX_POWER_DBM=22

# Default base coordinates for offline tactical map (Latitude, Longitude)
NEXT_PUBLIC_BASE_LATITUDE=19.0760
NEXT_PUBLIC_BASE_LONGITUDE=72.8777
